{
  "name": "horror-tree",
  "version": "1.0.0",
  "description": "Kleines Horror-Waldspiel mit Three.js.",
  "main": "electron-main.js",
  "scripts": {
    "start": "node server.js",
    "window": "electron .",
    "serve": "node server.js --no-open",
    "build:installer": "powershell -ExecutionPolicy Bypass -File scripts/build-installer.ps1",
    "test": "playwright test verify.spec.js",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "android:build": "npx cap sync android && cd android && ./gradlew assembleDebug"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "electron": "^42.2.0",
    "three": "^0.164.1"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0"
  }
}
