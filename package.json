{
  "name": "horror-tree",
  "version": "2.0.0",
  "description": "Dreamcore-Horrorspiel zwischen Traumwald, Poolr\u00e4umen und vergessenen Erinnerungen.",
  "main": "electron-main.js",
  "scripts": {
    "start": "node server.js",
    "window": "electron .",
    "serve": "node server.js --no-open",
    "test": "node --test tests/core.test.mjs tests/server.test.cjs",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:build": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "build": "node scripts/build-web.cjs",
    "preview": "node scripts/serve-built.cjs",
    "test:browser": "playwright test",
    "android:add": "npm run build && npx cap add android"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "electron": "^42.2.0",
    "three": "0.164.1"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0"
  }
}
